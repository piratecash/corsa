# This image builds only corsa-node and corsa-cli. List the package directories
# explicitly so both BuildKit and the classic archive walker visit them.
**
!go.mod
!go.sum
!cmd/corsa-cli/*.go
!cmd/corsa-node/*.go
!internal/app/node/*.go
!internal/core/appdata/*.go
!internal/core/capture/*.go
!internal/core/chatlog/*.go
!internal/core/config/*.go
!internal/core/connauth/*.go
!internal/core/connbudget/*.go
!internal/core/contactlink/*.go
!internal/core/crashlog/*.go
!internal/core/datagram/*.go
!internal/core/debugserver/*.go
!internal/core/deeplink/*.go
!internal/core/directmsg/*.go
!internal/core/dmcontrol/*.go
!internal/core/domain/*.go
!internal/core/ebus/*.go
!internal/core/findnode/*.go
!internal/core/findnodebridge/*.go
!internal/core/gazeta/*.go
!internal/core/identity/*.go
!internal/core/logid/*.go
!internal/core/metrics/*.go
!internal/core/netcore/*.go
!internal/core/node/*.go
!internal/core/protocol/*.go
!internal/core/routing/*.go
!internal/core/rpc/*.go
!internal/core/secretfile/*.go
!internal/core/service/*.go
!internal/core/service/filerouter/*.go
!internal/core/service/filetransfer/*.go
!internal/core/sessionv2/*.go
!internal/core/storage/*.go
!internal/core/transport/*.go
!internal/core/trustedclock/*.go
!internal/crypto/ecdhgcm/*.go
!internal/startupfence/*.go
**/*_test.go
**/*.go/*
