<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Corsa</string>
	<key>CFBundleExecutable</key>
	<string>Corsa</string>
	<key>CFBundleIconFile</key>
	<string>app-icon.icns</string>
	<key>CFBundleIdentifier</key>
	<string>chat.corsa</string>
	<key>CFBundleName</key>
	<string>Corsa</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!--
	  corsa: links. LaunchServices routes a scheme to the bundle that
	  claims it here, and Gio turns the resulting Apple Event
	  (application:openURLs:) into an app.URLEvent — see
	  internal/core/deeplink. The claim is registered when the bundle is
	  first seen by LaunchServices (first launch, or lsregister); the
	  scheme string must stay equal to deeplink.Scheme, which
	  TestMacOSBundleDeclaresTheScheme checks.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>chat.corsa.link</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>corsa</string>
			</array>
		</dict>
	</array>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
