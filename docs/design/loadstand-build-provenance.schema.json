{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:corsa:t5g:v2",
  "$comment": "Runtime additionally checks UTF-8 byte/depth/value/path limits, dynamic source/seed/toolchain/artifact equality, exact ownership and real FD evidence. This is not a generic JSON Schema engine.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/source"
    },
    {
      "$ref": "#/$defs/seed"
    },
    {
      "$ref": "#/$defs/outputs"
    },
    {
      "$ref": "#/$defs/fingerprint"
    },
    {
      "$ref": "#/$defs/native_manifest"
    }
  ],
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f]).+(?<!/)$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        }
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "oid",
        "sha256",
        "size"
      ],
      "properties": {
        "oid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "mode": {
          "enum": [
            "100644",
            "100755"
          ]
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blob",
        "commit",
        "kind",
        "path",
        "role",
        "staged_capture_manifest_sha256",
        "tree"
      ],
      "properties": {
        "kind": {
          "enum": [
            "versioned",
            "staged_uncommitted"
          ]
        },
        "commit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536,
              "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
            }
          ]
        },
        "tree": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536,
              "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
            }
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f]).+(?<!/)$"
        },
        "blob": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536,
              "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
            }
          ]
        },
        "staged_capture_manifest_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536,
              "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
            }
          ]
        },
        "role": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "candidate_change",
                "instrumentation",
                "harness"
              ]
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "versioned"
              }
            }
          },
          "then": {
            "properties": {
              "commit": {
                "type": "string"
              },
              "tree": {
                "type": "string"
              },
              "staged_capture_manifest_sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "commit": {
                "type": "null"
              },
              "tree": {
                "type": "null"
              },
              "staged_capture_manifest_sha256": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after",
        "before",
        "op",
        "origin",
        "path"
      ],
      "properties": {
        "op": {
          "enum": [
            "add",
            "modify",
            "delete"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f]).+(?<!/)$"
        },
        "before": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/blob"
            }
          ]
        },
        "after": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/blob"
            }
          ]
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "add"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "type": "null"
              },
              "after": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "modify"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "type": "object"
              },
              "after": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "delete"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "type": "object"
              },
              "after": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit",
        "base_tree",
        "directory",
        "executable"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f]).+(?<!/)$"
        },
        "executable": {
          "$ref": "#/$defs/tool"
        },
        "base_commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
        },
        "base_tree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
        }
      }
    },
    "seed_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "manifest_sha256",
        "root"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f]).+(?<!/)$"
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f]).+(?<!/)$"
        },
        "manifest_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        }
      }
    },
    "toolchain_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "go",
        "goroot",
        "manifest_path",
        "manifest_sha256"
      ],
      "properties": {
        "go": {
          "$ref": "#/$defs/tool"
        },
        "goroot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f]).+(?<!/)$"
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f]).+(?<!/)$"
        },
        "manifest_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        }
      }
    },
    "native_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ar",
        "cc",
        "cxx",
        "ld",
        "manifest_path",
        "manifest_sha256",
        "pkg_config",
        "roots"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f]).+(?<!/)$"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "cc": {
          "$ref": "#/$defs/tool"
        },
        "cxx": {
          "$ref": "#/$defs/tool"
        },
        "pkg_config": {
          "$ref": "#/$defs/tool"
        },
        "ld": {
          "$ref": "#/$defs/tool"
        },
        "ar": {
          "$ref": "#/$defs/tool"
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f]).+(?<!/)$"
        },
        "manifest_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "absent_native_host",
            "externally_declared_unverified"
          ]
        },
        "digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536,
              "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "absent_native_host"
              }
            }
          },
          "then": {
            "properties": {
              "digest": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "digest": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flavour",
        "git",
        "image",
        "keep_work",
        "native",
        "overlay",
        "schema_version",
        "seed",
        "targets",
        "toolchain"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            2
          ]
        },
        "git": {
          "$ref": "#/$defs/git"
        },
        "overlay": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlay"
          },
          "minItems": 0,
          "maxItems": 100000,
          "uniqueItems": false
        },
        "seed": {
          "$ref": "#/$defs/seed_request"
        },
        "toolchain": {
          "$ref": "#/$defs/toolchain_request"
        },
        "native": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/native_request"
            }
          ]
        },
        "flavour": {
          "enum": [
            "native-linux-arm64",
            "cross-compile-cgo0"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "enum": [
              "corsa-node",
              "sdkedge",
              "linuxhelper"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "keep_work": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "flavour": {
                "const": "native-linux-arm64"
              }
            }
          },
          "then": {
            "properties": {
              "native": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "native": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f]).+(?<!/)$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        },
        "mode": {
          "enum": [
            "100644",
            "100755"
          ]
        }
      }
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blob",
        "mode",
        "origin",
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f]).+(?<!/)$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        },
        "mode": {
          "enum": [
            "100644",
            "100755"
          ]
        },
        "blob": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit",
        "base_tree",
        "epoch",
        "files",
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            2
          ]
        },
        "base_commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
        },
        "base_tree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_file"
          },
          "minItems": 1,
          "maxItems": 100000,
          "uniqueItems": false
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            2
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "minItems": 1,
          "maxItems": 100000,
          "uniqueItems": false
        }
      }
    },
    "seed_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f\\x7f]).+(?<!/)$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "mod",
            "info",
            "zip",
            "ziphash"
          ]
        }
      }
    },
    "seed_module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "path",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+incompatible)?$"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/seed_file"
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": false
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            2
          ]
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/seed_module"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": false
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "sha256",
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_started",
            "present_verified",
            "unavailable",
            "invalid",
            "unconfirmed"
          ]
        },
        "sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536,
              "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
            }
          ]
        },
        "reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "present_verified"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "string"
              },
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "sha256": {
                "type": "null"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "phase"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "possible_writers",
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "complete",
            "kept_work",
            "unconfirmed",
            "incomplete"
          ]
        },
        "possible_writers": {
          "type": "boolean"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "reported_version_state",
        "runtime_exe_state",
        "sha256",
        "size",
        "target"
      ],
      "properties": {
        "lane": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "target": {
          "enum": [
            "corsa-node",
            "sdkedge",
            "linuxhelper"
          ]
